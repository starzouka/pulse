###> app/friend-recommendation-ai ###
# Provider values: ollama | openai | none
FRIEND_RECO_AI_PROVIDER=ollama

# Shared model variable.
# Example with OpenAI: gpt-4.1-mini
# Example with Ollama: gpt-oss:20b
FRIEND_RECO_AI_MODEL=gpt-oss:20b

# Fallback model if the primary Ollama model is slow/unavailable.
FRIEND_RECO_OLLAMA_FALLBACK_MODEL=gemma3:4b

# Speed controls (fast page load)
FRIEND_RECO_CANDIDATE_POOL=6
FRIEND_RECO_CACHE_TTL_SECONDS=300
FRIEND_RECO_LAST_SUCCESS_TTL_SECONDS=3600
FRIEND_RECO_OLLAMA_TIMEOUT_MS=7000
FRIEND_RECO_OLLAMA_FALLBACK_TIMEOUT_MS=5000
FRIEND_RECO_OLLAMA_RETRIES=2
FRIEND_RECO_OLLAMA_TAGS_TIMEOUT_MS=1200
FRIEND_RECO_OLLAMA_NUM_CTX=1536
FRIEND_RECO_OLLAMA_MAX_TOKENS=140
FRIEND_RECO_OLLAMA_KEEP_ALIVE=20m

# OpenAI config (used only when FRIEND_RECO_AI_PROVIDER=openai)
FRIEND_RECO_OPENAI_API_KEY=
FRIEND_RECO_OPENAI_BASE_URL=https://api.openai.com/v1
FRIEND_RECO_OPENAI_TIMEOUT_MS=4500
FRIEND_RECO_OPENAI_MAX_TOKENS=140

# Ollama config (used only when FRIEND_RECO_AI_PROVIDER=ollama)
FRIEND_RECO_OLLAMA_BASE_URL=http://127.0.0.1:11434
###< app/friend-recommendation-ai ###
