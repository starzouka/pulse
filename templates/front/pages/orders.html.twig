{% extends 'base.html.twig' %}

{% block title %}Mes commandes{% endblock %}

{% block body %}
<h1>Mes commandes</h1>

{% if orders is defined and orders is not empty %}
    <ul class="orders-list">
        {% for order in orders %}
            <li>
                <a href="{{ path('front_order_detail', { id: order.orderId }) }}">Commande {{ order.orderNumber }}</a>
                - Statut: {{ order.status }} - Montant: {{ order.totalAmount }}
            </li>
        {% endfor %}
    </ul>
{% else %}
    <p>Aucune commande trouvée.</p>
{% endif %}

{% include 'shared/_ai_assistant.html.twig' %}

{% endblock %}
