<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <title>Liste des produits - PULSE</title>
  <style>
    body {
      font-family: DejaVu Sans, sans-serif;
      color: #0f172a;
      font-size: 12px;
      margin: 0;
      padding: 20px;
      background-color: #f8fafc;
    }
    .container {
      width: 100%;
      max-width: 100%;
      margin: 0;
      background-color: #ffffff;
      padding: 20px;
      box-shadow: none;
    }
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
      padding-bottom: 15px;
      border-bottom: 2px solid #ff9d2e;
    }
    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .logo img {
      height: 50px;
      width: auto;
    }
    .logo-text {
      font-size: 24px;
      font-weight: 800;
      color: #ff9d2e;
    }
    .report-info {
      text-align: right;
      color: #6b7280;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
      table-layout: fixed;
    }
    th, td {
      border: 1px solid #e6eef8;
      padding: 10px;
      text-align: left;
    }
    th {
      background-color: #ff9d2e;
      color: #ffffff;
      font-weight: 700;
    }
    tr:nth-child(even) {
      background-color: #f8fafc;
    }
    .muted {
      color: #6b7280;
      font-size: 11px;
    }
    .status-badge {
      display: inline-block;
      padding: 3px 8px;
      border-radius: 12px;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
    }
    .status-active {
      background-color: #d4edda;
      color: #155724;
    }
    .status-inactive {
      background-color: #f8d7da;
      color: #721c24;
    }
    .footer {
      margin-top: 30px;
      text-align: center;
      color: #6b7280;
      font-size: 10px;
      border-top: 1px solid #e6eef8;
      padding-top: 10px;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div class="logo">
        <img src="{{ base_url }}/assets/template_fo/img/logo.jpeg" alt="PULSE Logo" />
        <div class="logo-text">PULSE E-SPORTS</div>
      </div>
      <div class="report-info">
        <div>Rapport des produits</div>
        <div>Généré: {{ "now"|date("d/m/Y H:i") }}</div>
        <div>Total: {{ productsData|length }} produit(s)</div>
      </div>
    </div>

    <table>
      <thead>
        <tr>
          <th style="width:30%;">Nom</th>
          <th style="width:12%;">Équipe</th>
          <th style="width:12%;">Prix</th>
          <th style="width:8%;">Stock</th>
          <th style="width:8%;">Actif</th>
          <th style="width:12%;">SKU</th>
          <th style="width:18%;">Créé le</th>
        </tr>
      </thead>
      <tbody>
        {% for data in productsData %}
          {% set product = data.product %}
          <tr>
            <td>
              <div style="font-weight:700;">{{ product.name|default('—') }}</div>
              <div class="muted">{{ product.description|default('')|striptags|slice(0,100) }}</div>
            </td>
            <td>{{ product.teamId.name|default('—') }}</td>
            <td>{{ product.price ? product.price|number_format(2, '.', ' ') ~ ' DT' : '—' }}</td>
            <td>{{ product.stockQty|default(0) }}</td>
            <td>
              {% if product.isActive %}
                <span class="status-badge status-active">Oui</span>
              {% else %}
                <span class="status-badge status-inactive">Non</span>
              {% endif %}
            </td>
            <td>{{ product.sku|default('—') }}</td>
            <td>{{ product.createdAt ? product.createdAt|date('d/m/Y H:i') : '—' }}</td>
          </tr>
        {% else %}
          <tr><td colspan="7" class="muted">Aucun produit</td></tr>
        {% endfor %}
      </tbody>
    </table>

    <div class="footer">
      <div>PULSE E-SPORTS - Plateforme de tournois e-sports et boutique en ligne</div>
      <div>Généré automatiquement le {{ "now"|date("d/m/Y H:i") }}</div>
    </div>
  </div>
</body>
</html>
