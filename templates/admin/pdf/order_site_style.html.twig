<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  {# Load admin CSS using absolute URLs so Dompdf can fetch them when isRemoteEnabled=true #}
  {% set css1 = base_url ~ asset('assets/template_bo/css/styles.css') %}
  {% set css2 = base_url ~ asset('assets/template_bo/css/tailwind.css') %}
  <link rel="stylesheet" href="{{ css1 }}" />
  <link rel="stylesheet" href="{{ css2 }}" />
  <style>
    {{ inline_css|default('')|raw }}
    /* Minor overrides so Dompdf renders predictably */
    body { font-family: DejaVu Sans, sans-serif; color: #0f172a; font-size:12px; margin:18px; }
    .pdf-header { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:16px; }
    .pdf-title { font-size:18px; font-weight:700; color:#0f172a; }
    table { width:100%; border-collapse:collapse; margin-top:10px; }
    th, td { border:1px solid #e6eef8; padding:8px; text-align:left; vertical-align:top; }
    th { background:#f8fafc; font-weight:700; }
    .muted { color:#6b7280; font-size:11px; }
    .totals { margin-top:12px; text-align:right; }
  </style>
</head>
<body>
  <div class="pdf-header">
    <div>
      <div class="pdf-title">PULSE - Commande {{ order.orderNumber }}</div>
      <div class="muted">{{ order.userId.username ?? '-' }}</div>
    </div>
    <div class="muted" style="text-align:right;">
      <div>Date: {{ order.createdAt ? order.createdAt|date('Y-m-d H:i') : '-' }}</div>
      <div>Statut: {{ order.status }} / {{ order.paymentStatus }}</div>
    </div>
  </div>

  <table class="pdf-table">
    <thead>
      <tr>
        <th>Produit</th>
        <th style="width:60px;">Qté</th>
        <th style="width:120px;">Prix unitaire</th>
        <th style="width:120px;">Total</th>
      </tr>
    </thead>
    <tbody>
      {% set subtotal = 0 %}
      {% for item in items %}
        {% set product = item.getProductId() %}
        {% set qty = item.getQuantity() %}
        {% set unit = (item.getUnitPriceAtAdd() is not null ? item.getUnitPriceAtAdd() : '0.00')|float %}
        {% set line = qty * unit %}
        {% set subtotal = subtotal + line %}
        <tr>
          <td>
            <div style="font-weight:700;">{{ product ? product.getName() : '—' }}</div>
            <div class="muted">{{ product ? product.getDescription()|striptags|slice(0,120) : '' }}</div>
          </td>
          <td>{{ qty }}</td>
          <td>{{ unit|number_format(2, '.', ' ') }} DT</td>
          <td>{{ line|number_format(2, '.', ' ') }} DT</td>
        </tr>
      {% else %}
        <tr><td colspan="4" class="muted">Aucun article</td></tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="totals">
    <div class="muted">Sous-total: {{ subtotal|number_format(2, '.', ' ') }} DT</div>
    <div style="font-weight:700; font-size:14px;">Total: {{ order.totalAmount ? order.totalAmount : subtotal|number_format(2, '.', ' ') }} DT</div>
  </div>

  <div style="margin-top:16px; font-size:11px; color:#6b7280;">Merci pour votre commande.</div>
</body>
</html>
