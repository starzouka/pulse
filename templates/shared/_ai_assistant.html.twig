{# Minimal AI assistant widget include #}
<div class="ai-assistant-button" aria-hidden="true"></div>
<div class="ai-assistant-window" role="dialog" aria-label="AI Assistant" hidden>
    <div class="ai-assistant-header">
        <h3>Assistant</h3>
        <button type="button" class="ai-assistant-close">&times;</button>
    </div>
    <div class="ai-assistant-messages"></div>
    <div class="ai-assistant-input">
        <input type="text" placeholder="Posez votre question..." />
        <button class="ai-assistant-send">Envoyer</button>
    </div>
</div>
